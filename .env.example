# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# POSTGRES_URL or DATABASE_URL: Recommended persistent PostgreSQL connection string for Vercel production deployments (e.g. Supabase, Neon, Vercel Postgres).
# Automatically creates schema, migrates existing orders, and prevents serverless container data loss.
POSTGRES_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgres://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DATABASE_PATH: Fallback local SQLite database path when PostgreSQL is not configured (for local dev).
DATABASE_PATH="data/norva_store.sqlite"

# ADMIN_USERNAME: Admin username (defaults to zn8xc if left empty).
ADMIN_USERNAME="zn8xc"

# ADMIN_PASSWORD: Plaintext password (defaults to usman122, hashed with bcrypt cost 12 at runtime; never stored in plaintext).
ADMIN_PASSWORD="usman122"

# ADMIN_PASSWORD_HASH: Optional pre-computed bcrypt ($2b$12$...) hash if you prefer injecting raw hash instead of plaintext.
ADMIN_PASSWORD_HASH=""

# ADMIN_SETUP_TOKEN: Optional secret token enabling POST /api/admin/activate for remote credential rotation.
ADMIN_SETUP_TOKEN=""

# VITE_WHATSAPP_NUMBER: Client WhatsApp concierge number (defaults to 923012697458).
VITE_WHATSAPP_NUMBER="923012697458"
